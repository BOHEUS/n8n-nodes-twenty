{
	"name": "n8n-nodes-twenty",
	"version": "0.1.0",
	"description": "n8n node for Twenty CRM: read and write records of any object, including custom objects and fields",
	"license": "MIT",
	"homepage": "https://github.com/twentyhq/twenty-n8n-nodes",
	"keywords": [
		"n8n-community-node-package",
		"twenty",
		"crm"
	],
	"author": {
		"name": "BOHEUS",
		"email": "contact@twenty.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twentyhq/twenty-n8n-nodes.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TwentyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Twenty/Twenty.node.js",
			"dist/nodes/TwentyTrigger/TwentyTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.29.0",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
